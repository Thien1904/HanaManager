# ================================================
# RESTAURANT POS - Environment Variables
# Copy file này thành .env.local và điền giá trị
# KHÔNG commit file .env.local lên GitHub!
# ================================================

# Supabase (lấy từ Project Settings > API trong Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (tự đặt 1 chuỗi ngẫu nhiên dài, dùng để ký token)
# Tạo bằng: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Anthropic Claude API (lấy từ console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# App Config
NEXT_PUBLIC_APP_NAME=Restaurant POS
NEXT_PUBLIC_APP_URL=http://localhost:3000
